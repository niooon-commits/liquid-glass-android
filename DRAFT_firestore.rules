rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function isAdmin() {
      return isSignedIn() && (
        request.auth.token.email == 'niooon@cinelink.fun' ||
        exists(/databases/$(database)/documents/admins/$(request.auth.uid))
      );
    }

    function isValidTransaction(data) {
      return data.invoiceId is string && data.invoiceId.size() <= 64
        && data.customerName is string && data.customerName.size() <= 128
        && data.amount is number && data.amount >= 0
        && (data.status == 'Completed' || data.status == 'Pending' || data.status == 'Failed');
    }

    function isValidUser(data) {
      return data.name is string && data.name.size() <= 128
        && data.email is string && data.email.size() <= 128
        && data.role is string && data.role.size() <= 64;
    }

    function isValidKpi(data) {
      return data.title is string && data.title.size() <= 64
        && data.value is string && data.value.size() <= 64;
    }

    function isValidNotification(data) {
      return data.title is string && data.title.size() <= 128
        && data.desc is string && data.desc.size() <= 512;
    }

    match /test/{testId} {
      allow read: if true;
      allow write: if isSignedIn();
    }

    match /transactions/{transactionId} {
      allow read: if true;
      allow create: if isSignedIn() && isValidId(transactionId) && isValidTransaction(incoming());
      allow update: if isSignedIn() && isValidId(transactionId) && isValidTransaction(incoming());
      allow delete: if isSignedIn() && isValidId(transactionId);
    }

    match /users/{userId} {
      allow read: if true;
      allow create, update: if isSignedIn() && isValidId(userId) && isValidUser(incoming());
      allow delete: if isSignedIn() && isValidId(userId);
    }

    match /kpi_metrics/{metricId} {
      allow read: if true;
      allow create, update: if isSignedIn() && isValidId(metricId) && isValidKpi(incoming());
      allow delete: if isSignedIn() && isValidId(metricId);
    }

    match /notifications/{notificationId} {
      allow read: if true;
      allow create: if isSignedIn() && isValidId(notificationId) && isValidNotification(incoming());
      allow update: if isSignedIn() && isValidId(notificationId);
      allow delete: if isSignedIn() && isValidId(notificationId);
    }

    match /admins/{adminId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }
  }
}
